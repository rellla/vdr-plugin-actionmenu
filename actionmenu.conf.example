# actionmenu.conf - entries of the action menu
#
# <key> "<text>"[?] [<state> [<refresh>]] <action>
# <key> "<text>" <state> [<refresh>]           (only shows the state)
# - "<text>"                                   (header)
# <key> "<text>"[?] [<state>] (                (chain of actions)
#     <action>
# )
# <key> "<text>" [<state>] {
#     <entries of the submenu>
# }
#
# ?:      ask before the action
# state:  [svdrp <plugin> <command>] or [shell <command>], the reply or the output
#         is shown as state of the entry, [refresh [<seconds>]] after it reads it
#         again periodically
#
# key:    0 - 9, Red, Green, Yellow, Blue or - (no key, only in the list)
# action: svdrp <plugin> <command> [<options>]   SVDRP command of a plugin
#         plugin <plugin>                        open the main menu of a plugin
#         key <key> [<key> ...]                  send keys to VDR
#         shell <command>                        run a command in the background
#         channel <number | channel ID>          switch to a channel
#         output <command>                       run a command and show its output
#         svdrp! and shell! keep the menu open.
# placeholders in commands: %channel%, %channelid%, %recording%
# sections:  [live], [replay] and [all] (default) show the following entries only
#            without replay, during a replay or always

Red     "Output"            {
    1   "Detach"?           svdrp drmdevice DETA
    2   "Attach"            svdrp drmdevice ATTA
    3   "Passthrough"       [svdrp drmdevice PASS] svdrp! drmdevice PASS toggle
}
[live]
Green   "Das Erste"         channel S19.2E-1-1019-10301
Yellow  "ZDF"               channel S19.2E-1-1079-28006
[replay]
Green   "Recording info"    output ls -l "%recording%"
[all]
Blue    "Picture in picture" {
    1   "On/off"            svdrp drmdevice PITO
    2   "Channel +"         svdrp! drmdevice PIPU
    3   "Channel -"         svdrp! drmdevice PIPD
    4   "Swap channels"     svdrp drmdevice PIPC
    5   "Swap position"     svdrp! drmdevice PIPP
    6   "Current channel"   svdrp drmdevice PION %channel%
}
-       "Functions"
1       "Ambient light"     [svdrp hyperion AMBI] svdrp! hyperion AMBI toggle
2       "EPG search"        plugin epgsearch
3       "Timers"            key Timers
4       "Zoom"              svdrp drmdevice ZOOM next
5       "Free space"        output df -h /storage 2>&1
-       "System"
-       "Temperature"       [shell vcgencmd measure_temp | cut -d= -f2] [refresh]
6       "TV off"?           (
        svdrp hyperion AMBI off
        svdrp drmdevice DETA
)
-       "Restart VDR"?      shell systemctl restart vdr
